# # Certificados TLS (generados localmente, no incluir en git)
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.pem

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Sensitive data files — employee/user data must never be in VCS
backend/usuarios.csv
backend/*.csv

# Debug / one-off scripts — keep out of repo
backend/debug_*.js
backend/create_*.js

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
dist/
build/
backend/dist/
frontend/dist/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Other
.idea/
.vscode/
*.swp
*.swo
